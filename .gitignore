*.py[cod]
*$py.class
*.so
.Python

# Environment variables (sensitive data)
.env
.env.local
.env.*.local

# IDE settings
.vscode/
.idea/
*.swp
*.swo
*~

# Logs
logs/
*.log

# Data files
data/raw/
data/processed/
*.pkl
*.pickle
*.h5
*.pt
*.pth

# Cache
.cache/
cache/
*.cache

# Test outputs
tests/outputs/
.coverage
htmlcov/
.pytest_cache/

# Build artifacts
dist/
build/
*.egg-info/
*.egg

# Jupyter notebooks
.ipynb_checkpoints/
*.ipynb

# OS files
.DS_Store
Thumbs.db

# Project specific
config/local_config.yaml
experiments/results/